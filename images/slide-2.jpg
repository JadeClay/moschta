<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="800" viewBox="0 0 1920 800">
  <defs>
    <linearGradient id="grad2" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#0d0d0d;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#222222;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d0d0d;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="gold2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#c9a96e;stop-opacity:0.2" />
      <stop offset="50%" style="stop-color:#c9a96e;stop-opacity:0.5" />
      <stop offset="100%" style="stop-color:#c9a96e;stop-opacity:0.2" />
    </linearGradient>
  </defs>
  <rect width="1920" height="800" fill="url(#grad2)"/>
  <rect x="860" y="200" width="200" height="400" fill="none" stroke="url(#gold2)" stroke-width="1"/>
  <rect x="910" y="250" width="100" height="300" fill="none" stroke="#c9a96e" stroke-width="0.5" opacity="0.3"/>
  <text x="960" y="390" font-family="Georgia, serif" font-size="48" fill="#c9a96e" text-anchor="middle" opacity="0.6">EXCELLENCE</text>
  <text x="960" y="440" font-family="Arial, sans-serif" font-size="16" fill="rgba(255,255,255,0.4)" text-anchor="middle" letter-spacing="8">SLIDE 2</text>
</svg>
